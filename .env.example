# Centralized configuration for docker compose and scripts/run_local.py.
# Copy to .env and change the secrets for anything beyond a local demo.

# Shared secret that trusted connectors present to the Data Space governance service
DATA_SPACE_SERVICE_TOKEN=dataspace-demo-token

# Participant API keys: key:participant_id (identity of the requester on provider APIs)
API_KEYS=traffic-demo-key:traffic_sensor_1,bus-demo-key:bus_line_12,parking-demo-key:parking_lot_5,bikes-demo-key:bikes_zone_a,edge-demo-key:edge_node_1,dashboard-demo-key:dashboard_operator,city-demo-key:city_planning_office,startup-demo-key:mobility_startup_x

# Each service's own key (must appear in API_KEYS)
TRAFFIC_API_KEY=traffic-demo-key
BUS_API_KEY=bus-demo-key
PARKING_API_KEY=parking-demo-key
BIKES_API_KEY=bikes-demo-key
EDGE_API_KEY=edge-demo-key
DASHBOARD_API_KEY=dashboard-demo-key

# Published host ports
DASHBOARD_PORT=8080
DASHBOARD_API_PORT=8000
DATA_SPACE_PORT=8010
EDGE_PORT=8020
